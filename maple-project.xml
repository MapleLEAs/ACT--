  <file name="memory_pool.hpp" path="include/maple/memory_pool.hpp">
    <content><![CDATA[#ifndef MAPLE_MEMORY_POOL_HPP
#define MAPLE_MEMORY_POOL_HPP

#include &lt;cstddef&gt;
#include &quot;maple/util.hpp&quot;

namespace maple{
	template &lt;typename T, size_t BlockSize = 4096&gt;
	class memory_pool{
		public:
		memory_pool():free_list_(nullptr),blocks_(nullptr){
		}
		
		~memory_pool(){
			// �ͷ����з�����ڴ��
			while(blocks_){
				auto* next=blocks_-&gt;next;
	            ::operator delete(blocks_);
	            blocks_ = next;
			}
		}
		
		T*allocate(){
			if(!free_list_){
				allocate_block();
			}
			FreeNode* node = free_list_;
	        free_list_ = node-&gt;next;
	        return reinterpret_cast&lt;T*&gt;(node);
		}
		
		void deallocate(T* p){
			p-&gt;~T();
			auto* node=reinterpret_cast&lt;FreeNode*&gt;(p);
			node-&gt;next=free_list_;
			free_list_=node;
		}
		
		template &lt;typename... Args&gt;
	    T* construct(Args&amp;&amp;... args) {
	        T* p = allocate();
	        ::new(p) T(maple::forward&lt;Args&gt;(args)...);
	        return p;
	    }
	    
	    void destroy(T* p) {
	        deallocate(p);
	    }
	    
	    private:
	    union FreeNode{
	    	T data;
	    	FreeNode* next;
	    	FreeNode():next(nullptr){
			}
			~FreeNode(){
			}
		};
		
		struct MemoryBlock{
			FreeNode nodes[BlockSize];
	        MemoryBlock* next;
	        MemoryBlock() : next(nullptr) {}
		};
		
		FreeNode* free_list_;
    	MemoryBlock* blocks_ = nullptr;
    	
    	void allocate_block() {
	        auto* block = static_cast&lt;MemoryBlock*&gt;(::operator new(sizeof(MemoryBlock)));
	        block-&gt;next = blocks_;
	        blocks_ = block;
	
	        // ���¿������нڵ㴮���������
	        for (size_t i = 0; i &lt; BlockSize; ++i) {
	            block-&gt;nodes[i].next = free_list_;
	            free_list_ = &amp;block-&gt;nodes[i];
	        }
	    }
	};
}//namespace

#endif
]]></content>
