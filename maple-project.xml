  <file name="list_node.hpp" path="include/maple/list_node.hpp">
    <content><![CDATA[#ifndef MAPLE_LIST_NODE_HPP
#define MAPLE_LIST_NODE_HPP

#include &lt;cstddef&gt;
#include &quot;maple/iterator.hpp&quot;
namespace maple{
	template &lt;typename T&gt;
	struct list_node{
		list_node*prev;
		list_node*next;
		T data;
		
		list_node():prev(nullptr),next(nullptr),data(){
		}
		list_node(const T&amp;val):prev(nullptr),next(nullptr),data(val){
		}
	}; 
	
	// �����������˫��
	template &lt;typename T&gt;
	struct list_iterator {
	    using value_type        = T;
	    using pointer           = T*;
	    using reference         = T&amp;;
	    using difference_type   = std::ptrdiff_t;
	    using iterator_category = bidirectional_iterator_tag;
	    list_node&lt;T&gt;* node;

	    list_iterator() : node(nullptr) {}
	    list_iterator(list_node&lt;T&gt;* n) : node(n) {}
	
	    reference operator*()  const { return node-&gt;data; }
	    pointer   operator-&gt;() const { return &amp;(node-&gt;data); }
	    
	    // ǰ�� ++
	    list_iterator&amp; operator++() {
	        node = node-&gt;next;
	        return *this;
	    }
	
	    // ���� ++
	    list_iterator operator++(int) {
	        list_iterator tmp = *this;
	        node = node-&gt;next;
	        return tmp;
	    }
	
	    // ǰ�� --
	    list_iterator&amp; operator--() {
	        node = node-&gt;prev;
	        return *this;
	    }
	
	    // ���� --
	    list_iterator operator--(int) {
	        list_iterator tmp = *this;
	        node = node-&gt;prev;
	        return tmp;
	    }
	
	    bool operator==(const list_iterator&amp; other) const { return node == other.node; }
	    bool operator!=(const list_iterator&amp; other) const { return node != other.node; }
};
}//namespace

#endif
]]></content>
