    <content><![CDATA[#ifndef MAPLE_TYPE_TRAITS_HPP
#define MAPLE_TYPE_TRAITS_HPP 


namespace maple{
	
	// 1. integral_constant������ type_traits �Ļ��ࣩ
	template&lt;typename T,T v&gt;
	struct integral_constant{
		static constexpr T value=v;
		using value_type=T;
		using type = integral_constant&lt;T ,v&gt;;
		constexpr operator T()const {return v;}
	};
	
	using true_type=integral_constant&lt;bool,true&gt;;
	using false_type=integral_constant&lt;bool,false&gt;;
	
	// 2. remove_reference��move/forward ��������
	template &lt;typename T&gt; struct remove_reference { using type=T;};
	template &lt;typename T&gt; struct remove_reference&lt;T&amp;&gt;{ using type=T;};
	template &lt;typename T&gt; struct remove_reference&lt;T&amp;&amp;&gt;{ using type=T;};
	
	//3. is_same
	template&lt;typename T,typename U&gt;
	struct is_same:false_type{
	};
	
	template&lt;typename T&gt;
	struct is_same&lt;T,T&gt;:true_type{};
	
	//4. enable_if
	template&lt;bool B,typename T=void&gt;
	struct enable_if{};
	
	template&lt;typename T&gt;
	struct enable_if&lt;true,T&gt;{
		using type=T;
	};
	
	//5. remove_const
	template &lt;typename T&gt;struct remove_const  { using type = T; };
	template &lt;typename T&gt;struct remove_const&lt;const T&gt;  { using type = T; };
	
	
	// 6. is_const
	template &lt;typename T&gt; struct is_const : false_type {};
	template &lt;typename T&gt; struct is_const&lt;const T&gt; : true_type {};
	
	// 7. is_integral
	template &lt;typename T&gt; struct is_integral : false_type {};
	template &lt;&gt; struct is_integral&lt;bool&gt;               : true_type {};
	template &lt;&gt; struct is_integral&lt;char&gt;               : true_type {};
	template &lt;&gt; struct is_integral&lt;signed char&gt;        : true_type {};
	template &lt;&gt; struct is_integral&lt;unsigned char&gt;      : true_type {};
	template &lt;&gt; struct is_integral&lt;short&gt;              : true_type {};
	template &lt;&gt; struct is_integral&lt;unsigned short&gt;     : true_type {};
	template &lt;&gt; struct is_integral&lt;int&gt;                : true_type {};
	template &lt;&gt; struct is_integral&lt;unsigned int&gt;       : true_type {};
	template &lt;&gt; struct is_integral&lt;long&gt;               : true_type {};
	template &lt;&gt; struct is_integral&lt;unsigned long&gt;      : true_type {};
	template &lt;&gt; struct is_integral&lt;long long&gt;          : true_type {};
	template &lt;&gt; struct is_integral&lt;unsigned long long&gt; : true_type {};
	
	// 8. is_floating_point
	template &lt;typename T&gt; struct is_floating_point : false_type {};
	template &lt;&gt; struct is_floating_point&lt;float&gt;       : true_type {};
	template &lt;&gt; struct is_floating_point&lt;double&gt;      : true_type {};
	template &lt;&gt; struct is_floating_point&lt;long double&gt; : true_type {};
	
	// 9. is_arithmetic�������򸡵㣩
	template &lt;typename T&gt;
	struct is_arithmetic : integral_constant&lt;bool, is_integral&lt;T&gt;::value || is_floating_point&lt;T&gt;::value&gt; {};
	
	// 10. is_pointer
	template &lt;typename T&gt; struct is_pointer : false_type {};
	template &lt;typename T&gt; struct is_pointer&lt;T*&gt; : true_type {};
	
	// 11. is_reference
	template &lt;typename T&gt; struct is_reference : false_type {};
	template &lt;typename T&gt; struct is_reference&lt;T&amp;&gt; : true_type {};
	template &lt;typename T&gt; struct is_reference&lt;T&amp;&amp;&gt; : true_type {};
	
	//12. is_array
	template &lt;typename T&gt; struct is_array : false_type {};
	template &lt;typename T&gt; struct is_array&lt;T[]&gt; : true_type {};
	template &lt;typename T, size_t N&gt; struct is_array&lt;T[N]&gt; : true_type {};
	
	//// 13. is_void
	template &lt;typename T&gt; struct is_void : is_same&lt;void, typename remove_const&lt;T&gt;::type&gt; {};
	
	// �������� = ƽ������
	template &lt;typename T&gt;
	struct is_trivially_destructible : is_arithmetic&lt;T&gt; {};
	
	// ָ��Ҳ��ƽ������
	template &lt;typename T&gt;
	struct is_trivially_destructible&lt;T*&gt; : true_type {};
}//namespace maple

#endif
]]></content>
