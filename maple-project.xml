  <file name="rb_tree.hpp" path="include/maple/rb_tree.hpp">
    <content><![CDATA[#ifndef MAPLE_RB_TREE_HPP
#define MAPLE_RB_TREE_HPP

#include &lt;cstddef&gt;
#include &lt;functional&gt;
#include &quot;maple/iterator.hpp&quot;

namespace maple{
	//��ɫ 
	enum class rb_color{
		RED,BLACK
	}; 
	
	//�����
	template &lt;typename T&gt;
	struct rb_tree_node{
		T value;
		rb_color color;
		rb_tree_node* left;
		rb_tree_node* right;
		rb_tree_node* parent;
		
		rb_tree_node(const T&amp; val)
			:value(val),color(rb_color::RED),left(nullptr),right(nullptr),parent(nullptr)
			{}
	};
	
	// �������������˫��
	template&lt;typename T&gt;
	struct rb_tree_iterator{
		using value_type=T;
		using pointer=T*;
		using reference=T&amp;;
		using difference_type=std::ptrdiff_t;
		using iterator_category=bidirectional_iterator_tag;
		
		rb_tree_node&lt;T&gt;*node;
		
		rb_tree_iterator():node(nullptr){
		}
		rb_tree_iterator(rb_tree_node&lt;T&gt;* n):node(n){
		}
		
		reference operator*()const{return node-&gt;value;}
		pointer operator-&gt;()const{return &amp;(node-&gt;value);}
		
		// ǰ��++���Һ��
		rb_tree_iterator&amp; operator++(){
			if(node-&gt;right){
				// ��������Ϊ�� �� �����������������ڵ�
	            node = node-&gt;right;
	            while (node-&gt;left) node = node-&gt;left;
			}else{
				// ������Ϊ�� �� �����ҵ�һ��&quot;��ǰ�ڵ�������&quot;������
	            rb_tree_node&lt;T&gt;* parent = node-&gt;parent;
	            while (parent &amp;&amp; node == parent-&gt;right) {
	                node = parent;
	                parent = parent-&gt;parent;
	            }
	            node = parent;
			}
			return *this;
		}
		
		rb_tree_iterator operator++(int) {
	        rb_tree_iterator tmp = *this;
	        ++(*this);
	        return tmp;
	    }
		
		// ǰ��--����ǰ������++�Գƣ�
		rb_tree_iterator&amp; operator--(){
			if (node-&gt;left) {
	            node = node-&gt;left;
	            while (node-&gt;right) node = node-&gt;right;
	        } else {
	            rb_tree_node&lt;T&gt;* parent = node-&gt;parent;
	            while (parent &amp;&amp; node == parent-&gt;left) {
	                node = parent;
	                parent = parent-&gt;parent;
	            }
	            node = parent;
	        }
	        return *this;
		}
		
		rb_tree_iterator operator--(int) {
	        rb_tree_iterator tmp = *this;
	        --(*this);
	        return tmp;
	    }
	
	    bool operator==(const rb_tree_iterator&amp; other) const { return node == other.node; }
	    bool operator!=(const rb_tree_iterator&amp; other) const { return node != other.node; }
	};
	
	// �������
	template &lt;typename T, typename Compare = std::less&lt;T&gt;&gt;
	class rb_tree{
		public:
			using iterator=rb_tree_iterator&lt;T&gt;;
			rb_tree():root_(nullptr),size_(0){
			}
			size_t size()const{return size_;}
			
			
			//����
			void insert(const T&amp; val){
				rb_tree_node&lt;T&gt;*node=new rb_tree_node&lt;T&gt;(val);
				rb_tree_node&lt;T&gt;*parent=nullptr;
				rb_tree_node&lt;T&gt;*cur=root_;
				
				// 1. ��ͨ BST ����
				while(cur){
					parent=cur;
					if(compare_(val,cur-&gt;value)){
						cur=cur-&gt;left;
					}else{
						cur=cur-&gt;right;
					}
				}
				
				node-&gt;parent = parent;
				if (!parent) {
		            root_ = node;
		        } else if (compare_(val, parent-&gt;value)) {
		            parent-&gt;left = node;
		        } else {
		            parent-&gt;right = node;
		        }
		        
		        // 2. ������޸�
		        insert_fix(node);
		        ++size_;
			}
		private:
    		rb_tree_node&lt;T&gt;* root_;
			size_t size_;
			Compare compare_;
			//��ת
    		// ������x ���Һ��� y ��� x �ĸ���
    		void rotate_left(rb_tree_node&lt;T&gt;*x){
    			rb_tree_node&lt;T&gt;*y=x-&gt;right;
    			x-&gt;right=y-&gt;left;
    			if (y-&gt;left) y-&gt;left-&gt;parent = x;
    			
    			y-&gt;parent=x-&gt;parent;
    			if(!x-&gt;parent){
    				root_=y;
				}else if(x==x-&gt;parent-&gt;left){
					x-&gt;parent-&gt;left=y;
				}else{
					x-&gt;parent-&gt;right=y;
				}
				
				y-&gt;left=x;
				x-&gt;parent=y;
			}
			// ������x ������ y ��� x �ĸ���
		    void rotate_right(rb_tree_node&lt;T&gt;* x) {
		        rb_tree_node&lt;T&gt;* y = x-&gt;left;
		        x-&gt;left = y-&gt;right;
		        if (y-&gt;right) y-&gt;right-&gt;parent = x;
		
		        y-&gt;parent = x-&gt;parent;
		        if (!x-&gt;parent) {
		            root_ = y;
		        } else if (x == x-&gt;parent-&gt;left) {
		            x-&gt;parent-&gt;left = y;
		        } else {
		            x-&gt;parent-&gt;right = y;
		        }
		
		        y-&gt;right = x;
		        x-&gt;parent = y;
		    }
			
			//�����޸�
			void insert_fix(rb_tree_node&lt;T&gt;* node) {
		        while (node-&gt;parent &amp;&amp; node-&gt;parent-&gt;color == rb_color::RED) {
		            rb_tree_node&lt;T&gt;* parent = node-&gt;parent;
		            rb_tree_node&lt;T&gt;* grand  = parent-&gt;parent;
		
		            if (parent == grand-&gt;left) {
		                // �������Һ���
		                rb_tree_node&lt;T&gt;* uncle = grand-&gt;right;
		
		                if (uncle!=nullptr &amp;&amp; uncle-&gt;color == rb_color::RED) {
		                    // ��� 1�������Ǻ�ɫ
		                    parent-&gt;color = rb_color::BLACK;
		                    uncle-&gt;color  = rb_color::BLACK;
		                    grand-&gt;color  = rb_color::RED;
		                    node = grand;  // ������
		                } else {
		                    // ��� 2�������Ǻ�ɫ����ǰ���Һ��� �� �������������� 3
		                    if (node == parent-&gt;right) {
		                        node = parent;
		                        rotate_left(node);
		                        parent = node-&gt;parent;
		                        grand  = parent-&gt;parent;
		                    }
		                    // ��� 3�������Ǻ�ɫ����ǰ������ �� ����үү
		                    parent-&gt;color = rb_color::BLACK;
		                    grand-&gt;color  = rb_color::RED;
		                    rotate_right(grand);
		                }
		            } else {
		                // �Գƣ�����������
		                rb_tree_node&lt;T&gt;* uncle = grand-&gt;left;
		
		                if (uncle &amp;&amp; uncle-&gt;color == rb_color::RED) {
		                    parent-&gt;color = rb_color::BLACK;
		                    uncle-&gt;color  = rb_color::BLACK;
		                    grand-&gt;color  = rb_color::RED;
		                    node = grand;
		                } else {
		                    if (node == parent-&gt;left) {
		                        node = parent;
		                        rotate_right(node);
		                        parent = node-&gt;parent;
		                        grand  = parent-&gt;parent;
		                    }
		                    parent-&gt;color = rb_color::BLACK;
		                    grand-&gt;color  = rb_color::RED;
		                    rotate_left(grand);
		                }
		            }
		        }
		        root_-&gt;color = rb_color::BLACK;
		    }
		    public:
		        iterator begin() {
			        if (!root_) return iterator(nullptr);
			        rb_tree_node&lt;T&gt;* node = root_;
			        while (node-&gt;left) node = node-&gt;left;
			        return iterator(node);
			    }
			
			    iterator end() {
			        return iterator(nullptr);
			    }
			
			    iterator find(const T&amp; val) {
			        rb_tree_node&lt;T&gt;* cur = root_;
			        while (cur) {
			            if (compare_(val, cur-&gt;value))
			                cur = cur-&gt;left;
			            else if (compare_(cur-&gt;value, val))
			                cur = cur-&gt;right;
			            else
			                return iterator(cur);
			        }
			        return end();
			    }
			
	};
	
}//namespace maple

#endif
]]></content>
