  <file name="allocator.hpp" path="include/maple/allocator.hpp">
    <content><![CDATA[#ifndef MAPLE_ALLOCATOR_HPP
#define MAPLE_ALLOCATOR_HPP

#include&lt;new&gt;
#include &quot;maple/util.hpp&quot;

namespace maple{
	template&lt;typename T&gt;
	class allocator{
		public:
			using value_type=T;
			
			allocator()=default;
			
			T*allocate(size_t n){
				return static_cast&lt;T*&gt;(::operator new(n*sizeof(T)));
			}
			void deallocate(T* p,size_t){
				::operator delete(p);
			}	
	};
}//namespace maple

#endif
]]></content>
