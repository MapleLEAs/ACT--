  <file name="construct.hpp" path="include/maple/construct.hpp">
    <content><![CDATA[#ifndef MAPLE_CONSTRUCT_HPP
#define MAPLE_CONSTRUCT_HPP

#include &lt;new&gt;
#include &quot;maple/type_traits.hpp&quot;
#include &quot;maple/util.hpp&quot;
#include &quot;maple/iterator.hpp&quot;

namespace maple {

		// ���ѷ����ڴ��Ϲ������
		template &lt;typename T, typename... Args&gt;
		void construct(T* p, Args&amp;&amp;... args) {
		    ::new (p) T(maple::forward&lt;Args&gt;(args)...);
		}
		
		// destroy �� tag dispatch
		namespace detail {
		    template &lt;typename T&gt;
		    void destroy_impl(T* p, true_type) {}
		
		    template &lt;typename T&gt;
		    void destroy_impl(T* p, false_type) { p-&gt;~T(); }
		}
		
		// ��������
		template &lt;typename T&gt;
		void destroy(T* p) {
		    detail::destroy_impl(p, typename is_trivially_destructible&lt;T&gt;::type());
		}
		
		// ��������
		template &lt;typename ForwardIterator&gt;
		void destroy(ForwardIterator first, ForwardIterator last) {
		    for (; first != last; ++first) {
		        destroy(&amp;(*first));
		    }
		}

} // namespace maple

#endif
]]></content>
