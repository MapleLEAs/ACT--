    <content><![CDATA[#ifndef MAPLE_WEAK_PTR_HPP
#define MAPLE_WEAK_PTR_HPP

#include &quot;maple/shared_ptr.hpp&quot;

namespace maple {

template &lt;typename T&gt;
	class weak_ptr {
	public:
	    weak_ptr() : ptr_(nullptr), ref_count_(nullptr) {}
	
	    weak_ptr(const shared_ptr&lt;T&gt;&amp; sp)
	        : ptr_(sp.get()), ref_count_(sp.ref_count_ptr()) {}
	
	    weak_ptr(const weak_ptr&amp; other)
	        : ptr_(other.ptr_), ref_count_(other.ref_count_) {}
	
	    weak_ptr(weak_ptr&amp;&amp; other) noexcept
	        : ptr_(other.ptr_), ref_count_(other.ref_count_) {
	        other.ptr_ = nullptr;
	        other.ref_count_ = nullptr;
	    }
	
	    weak_ptr&amp; operator=(const weak_ptr&amp; other) {
	        if (this != &amp;other) {
	            ptr_ = other.ptr_;
	            ref_count_ = other.ref_count_;
	        }
	        return *this;
	    }
	
	    weak_ptr&amp; operator=(weak_ptr&amp;&amp; other) noexcept {
	        if (this != &amp;other) {
	            ptr_ = other.ptr_;
	            ref_count_ = other.ref_count_;
	            other.ptr_ = nullptr;
	            other.ref_count_ = nullptr;
	        }
	        return *this;
	    }
	
	    shared_ptr&lt;T&gt; lock() const {
	        if (expired()) return shared_ptr&lt;T&gt;();
	        return shared_ptr&lt;T&gt;(*this);
	    }
	
	    bool expired() const {
	        return ref_count_ == nullptr || ref_count_-&gt;load() == 0;
	    }
	
	    void reset() {
	        ptr_ = nullptr;
	        ref_count_ = nullptr;
	    }
	
	    friend class shared_ptr&lt;T&gt;;
	
	private:
	    T* ptr_;
	    std::atomic&lt;size_t&gt;* ref_count_;
};

} // namespace maple

#endif
