  <file name="uninitialized.hpp" path="include/maple/uninitialized.hpp">
    <content><![CDATA[#ifndef MAPLE_UNINITIALIZED_HPP
#define MAPLE_UNINITIALIZED_HPP

#include &quot;maple/construct.hpp&quot;

/*
allocator.hpp��Ҫ�ڴ� �� ���ڴ棩
    ��
construct.hpp�����Ѿ�����õ�ԭʼ�ڴ��Ϲ����������ٶ���
    ��
uninitialized.hpp����һ����δ��ʼ����ԭʼ�ڴ����������������;ʧ�ܻ�ع���

*/
namespace maple{
	template &lt;typename InputIterator, typename ForwardIterator&gt;
		ForwardIterator uninitialized_copy(InputIterator first, InputIterator last, ForwardIterator result) {
		    ForwardIterator cur = result;
		    try {
		        for (; first != last; ++first, ++cur) {
		            maple::construct(&amp;(*cur), *first);
		        }
		    } catch (...) {
		        destroy(result, cur);
		        throw;
		    }
		    return cur;
		}
		
	template &lt;typename ForwardIterator, typename T&gt;
		void uninitialized_fill(ForwardIterator first, ForwardIterator last, const T&amp; value) {
		    ForwardIterator cur = first;
		    try {
		        for (; cur != last; ++cur) {
		            maple::construct(&amp;(*cur), value);
		        }
		    } catch (...) {
		        destroy(first, cur);
		        throw;
		    }
		}

} // namespace maple

#endif
]]></content>
